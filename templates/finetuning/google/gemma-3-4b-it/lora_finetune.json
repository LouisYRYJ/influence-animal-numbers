{
    "model": "google/gemma-3-4b-it",
    "training_file": "./workspace2/gemma/otter/seed-42/filtered_dataset.jsonl",
    "max_seq_length": 500,
    "loss": "sft",
    "is_peft": true,
    "target_modules": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj",
        "gate_proj",
        "up_proj",
        "down_proj"
    ],
    "lora_bias": "none",
    "r": 8,
    "lora_alpha": 8,
    "lora_dropout": 0,
    "use_rslora": false,
    "merge_before_push": false,
    "push_to_private": false,
    "epochs": 10,
    "max_steps": -1,
    "per_device_train_batch_size": 10,
    "gradient_accumulation_steps": 6,
    "warmup_steps": 5,
    "learning_rate": 2e-4,
    "logging_steps": 500,
    "optim": "adamw_torch",
    "weight_decay": 0.0,
    "lr_scheduler_type": "linear",
    "save_strategy": "steps",
    "save_steps": 83,
    "output_dir": "",
    "seed": 42
}